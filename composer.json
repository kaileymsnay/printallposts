{
    "name": "phpbbmodders/printallposts",
    "type": "phpbb-extension",
    "description": "Allows users, if they have the print topic permission for the forum the topic is located, to be able to print view all posts in a topic.",
    "homepage": "https://www.phpbbmodders.com/",
    "version": "1.0.4",
    "time": "2026-10-22",
    "keywords": [
        "phpbb",
        "extension",
        "print all posts in a topic",
        "communication"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "phpBB Modders",
            "email": "board@phpbbmodders.com",
            "homepage": "https://www.phpbbmodders.com/",
            "role": "Extension Developer"
        },
        {
            "name": "Rich McGirr",
            "role": "Past Developer"
        }
    ],
    "require": {
        "php": ">=8.3.36",
        "composer/installers": "~1.0.0"
    },
    "extra": {
        "display-name": "Print All Posts",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.19,<4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/print_all_posts_in_a_topic",
            "filename": "version_check",
            "ssl": true
        }
    }
}